# Copy to .env and adjust as needed. Backend also ships defaults in backend/app/config.py.

# Server
# Set this in your private local .env — do not commit real internal hostnames.
ARCHIVE_BASE_URL=http://YOUR_ARCHIVE_HOST:PORT/
ARCHIVE_ROUTE=HRIT_Native/

# Local data
DATA_ROOT=./data

# Sample selection (HH-MM, matching server folder names)
SAMPLE_DAYTIME_TARGET=09-00
SAMPLE_NIGHTTIME_TARGET=20-00
SAMPLE_TWILIGHT_TARGET=14-00
SAMPLE_TOLERANCE_MINUTES=30
# If a target has no timeslot within tolerance, still pick the nearest file on that date
SAMPLE_NEAREST_FALLBACK=true
SAMPLE_FILES_PER_DATE=3
DOWNLOAD_EVERYTHING_PER_DATE=false

# Download safety
MAX_CONCURRENT_DOWNLOADS=4
MIN_REQUEST_DELAY_SECONDS=0.25
DOWNLOAD_CHUNK_MB=4
MIN_FREE_DISK_GB=10.0

# Throughput (defaults target a 6-core CPU with 32 GB RAM)
DISCOVERY_WORKERS=8
PROCESSING_WORKERS=2
PROCESSING_THREADS_PER_WORKER=3
COMPOSITE_BATCH_SIZE=8
PNG_COMPRESS_LEVEL=1
JOB_PROGRESS_MIN_INTERVAL_SECONDS=2.0

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
